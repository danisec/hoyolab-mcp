# Copy to .env and fill in. Never commit the filled-in file.
#
#   cp .env.example .env
#   printf 'HOYOLAB_MCP_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
#
# Compose reads this file automatically for variable substitution, and the container
# receives the values listed in compose.yaml. When running the server without a
# container (`python -m hoyolab_mcp.main`), export these yourself instead.

# ---------------------------------------------------------------- required

# Encryption key for the per-user cookie store. At least 16 characters.
# Generate with: openssl rand -hex 32
#
# Changing this makes previously stored cookies unreadable; users re-link instead.
# The server refuses to start without it, because storing login cookies in plaintext
# would be worse than being unavailable. Compose also refuses to start without it, so
# the failure is reported before anything runs.
HOYOLAB_MCP_SECRET=

# ---------------------------------------------------------------- recommended

# Must equal Open WebUI's FORWARD_USER_INFO_HEADER_JWT_SECRET so this server can verify
# the identity token Open WebUI forwards. Leave empty only if you accept the weaker
# unsigned X-OpenWebUI-User-Id header.
#
# When this IS set, the plain X-OpenWebUI-User-Id header is ignored entirely -- an
# unsigned header cannot be trusted once a signing secret exists.
#
# Not needed for Claude Code / Codex / opencode, which authenticate with API tokens.
FORWARD_USER_INFO_HEADER_JWT_SECRET=

# ---------------------------------------------------------------- networking

# Reachable by the user's BROWSER — used to build the account-link URL.
# Example: https://hoyolab-mcp.example.com
HOYOLAB_MCP_PUBLIC_URL=http://localhost:8899

# Host interface to publish on. Keep 127.0.0.1 unless a reverse proxy on the same host
# terminates TLS for you: the server speaks plain HTTP, and publishing it on 0.0.0.0
# sends cookie-backed data over the network in the clear.
HOYOLAB_MCP_BIND=127.0.0.1

# Port on the HOST. Inside the container the server always listens on 8899.
HOYOLAB_MCP_PORT_HOST=8899

# Hosts allowed to reach the MCP endpoint (MCP's DNS-rebinding protection).
# Add your public hostname if you expose this through a reverse proxy, and keep the
# name:port form as well — the check compares the full Host header.
HOYOLAB_MCP_ALLOWED_HOSTS=hoyolab-mcp:8899,hoyolab-mcp,localhost:8899,localhost,127.0.0.1:8899,127.0.0.1

# ---------------------------------------------------------------- image

# Which image to run. Defaults to a locally built `hoyolab-mcp:latest`.
# Set this to a registry reference to run a published image instead of building:
#   HOYOLAB_MCP_IMAGE=ghcr.io/you/hoyolab-mcp:1.0.0
HOYOLAB_MCP_IMAGE=hoyolab-mcp:latest

# Reported by GET /health, so you can tell which build is running. Baked into the image
# at build time; set it to whatever identifies this build for you.
HOYOLAB_MCP_VERSION=dev

# ---------------------------------------------------------------- no container

# Only used when running the server directly, without Compose. Inside the container
# these are fixed by compose.yaml and do not need changing.
HOYOLAB_MCP_DB=/data/hoyolab.db
HOYOLAB_MCP_HOST=0.0.0.0
HOYOLAB_MCP_PORT=8899

# ---------------------------------------------------------------- API tokens

# API tokens for non-browser clients (Claude Code, Codex, opencode) are NOT configured
# here. They live in the database above and are minted locally, so that no HTTP route
# can hand out access:
#   docker compose exec hoyolab-mcp python -m hoyolab_mcp.cli issue-token --user alice
